{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
  },
  "watcher": {
    "ignore": ["node_modules/**", "out/**"],
  },
  "permission": {
    "edit": {
      "*": "allow",
      "test/input/**": "deny",
    },
  },
}
