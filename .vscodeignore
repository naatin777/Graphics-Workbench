**/.vscode-test.*

# The packaged extension executes the CommonJS entry point of pdf-lib. Its
# browser/ESM/TypeScript distributions duplicate the same implementation and
# are not reached by Node's package main field.
node_modules/pdf-lib/dist/**
node_modules/pdf-lib/es/**
node_modules/pdf-lib/src/**
node_modules/pdf-lib/ts3.4/**
node_modules/@pdf-lib/standard-fonts/dist/**
node_modules/@pdf-lib/standard-fonts/es/**
node_modules/@pdf-lib/upng/dist/**
node_modules/@pdf-lib/upng/UPNG.js
node_modules/@pdf-lib/upng/yarn.lock
node_modules/pako/dist/**

# These are hoisted only for Mermaid's source-only D3 dependency or Puppeteer's
# optional browser-install CLI. Mermaid ships self-contained ESM chunks and
# this extension only launches already-installed browsers.
node_modules/commander/**
node_modules/iconv-lite/**
node_modules/rw/**
node_modules/delaunator/**
node_modules/internmap/**
node_modules/tslib/**
node_modules/@puppeteer/browsers/node_modules/**
node_modules/modern-tar/**
node_modules/y18n/**
node_modules/get-caller-file/**

# These are browser bundles or generated protocol descriptions. Puppeteer
# loads its Node implementation directly; the protocol files are type/build
# inputs rather than runtime modules.
**/node_modules/puppeteer-core/lib/es5-iife/**
**/node_modules/chromium-bidi/lib/iife/**
**/node_modules/devtools-protocol/json/**
**/node_modules/devtools-protocol/pdl/**
**/node_modules/devtools-protocol/types/**

# Chromium BiDi uses Zod v3. The package also ships an unrelated v4 tree.
**/node_modules/zod/v4/**
**/node_modules/zod/v4-mini/**

# sharp is loaded through its ESM export; the CommonJS build, native build
# sources, and install helper are not needed in an installed extension.
node_modules/sharp/dist/**/*.cjs
node_modules/sharp/src/**
node_modules/sharp/install/**

# The test compilation emits a duplicate out/src tree; the extension entry
# points at out/extension.js and never loads this copy.
out/src/**

# Package documentation is not used at runtime. License files remain.
**/node_modules/**/README*
**/node_modules/**/CHANGELOG*

# Mermaid CLI loads the ESM bundles below. The core and minified builds are
# alternate distributions and are not reached by its runtime imports.
node_modules/mermaid/dist/chunks/mermaid.core/**
node_modules/mermaid/dist/chunks/mermaid.esm.min/**
node_modules/mermaid/dist/mermaid.js
node_modules/mermaid/dist/mermaid.min.js
node_modules/mermaid/dist/mermaid.core.mjs
node_modules/mermaid/dist/mermaid.esm.min.mjs
node_modules/@mermaid-js/layout-elk/dist/chunks/mermaid-layout-elk.core/**
node_modules/@mermaid-js/layout-elk/dist/chunks/mermaid-layout-elk.esm.min/**
node_modules/@mermaid-js/layout-elk/dist/mermaid-layout-elk.core.mjs
node_modules/@mermaid-js/layout-elk/dist/mermaid-layout-elk.esm.min.mjs
node_modules/@mermaid-js/mermaid-zenuml/dist/chunks/mermaid-zenuml.core/**
node_modules/@mermaid-js/mermaid-zenuml/dist/chunks/mermaid-zenuml.esm.min/**
node_modules/@mermaid-js/mermaid-zenuml/dist/mermaid-zenuml.core.mjs
node_modules/@mermaid-js/mermaid-zenuml/dist/mermaid-zenuml.esm.min.mjs
node_modules/@mermaid-js/mermaid-zenuml/dist/mermaid-zenuml.js
node_modules/@mermaid-js/mermaid-zenuml/dist/mermaid-zenuml.min.js
node_modules/@fortawesome/fontawesome-free/metadata/**
node_modules/@fortawesome/fontawesome-free/js/**
node_modules/@fortawesome/fontawesome-free/scss/**
node_modules/@fortawesome/fontawesome-free/sprites/**
node_modules/@fortawesome/fontawesome-free/sprites-full/**
node_modules/@fortawesome/fontawesome-free/svgs/**
node_modules/@fortawesome/fontawesome-free/svgs-full/**
node_modules/@fortawesome/fontawesome-free/css/*.min.css
node_modules/@fortawesome/fontawesome-free/css/svg*.css
node_modules/@fortawesome/fontawesome-free/css/v4-*.css
node_modules/@fortawesome/fontawesome-free/css/v5-*.css

# The Mermaid CLI loads ZenUML's self-contained ESM bundle in the browser.
# @zenuml/core and its Node/UI dependency subtree are not imported by that
# entry point; keeping them would ship an unused canvas and React runtime.
**/node_modules/@zenuml/core/**
**/node_modules/@napi-rs/canvas/**
**/node_modules/@napi-rs/canvas-*/**
**/node_modules/elkjs/**
**/node_modules/@floating-ui/**
**/node_modules/@headlessui/**
**/node_modules/@react-aria/**
**/node_modules/@react-types/**
**/node_modules/@tanstack/**
**/node_modules/@internationalized/**
**/node_modules/@swc/**
**/node_modules/@babel/**
**/node_modules/aria-hidden/**
**/node_modules/react/**
**/node_modules/react-aria/**
**/node_modules/react-stately/**
**/node_modules/react-dom/**
**/node_modules/scheduler/**
**/node_modules/use-sync-external-store/**
**/node_modules/antlr4/**
**/node_modules/class-variance-authority/**
**/node_modules/clsx/**
**/node_modules/color-string/**
**/node_modules/highlight.js/**
**/node_modules/html-to-image/**
**/node_modules/jotai/**
**/node_modules/tailwind-merge/**
**/node_modules/tailwindcss/**

# Mermaid's ESM chart bundles include these layout/rendering dependencies.
# The standalone packages are only reached by the alternate core bundles above.
**/node_modules/cytoscape/**
**/node_modules/cytoscape-fcose/**
**/node_modules/cytoscape-cose-bilkent/**
**/node_modules/cose-base/**
**/node_modules/layout-base/**
**/node_modules/robust-predicates/**
**/node_modules/d3/**
**/node_modules/d3-*/**
**/node_modules/dagre-d3-es/**
**/node_modules/roughjs/**

# Mermaid's browser ESM chunks also inline these transitive runtime modules.
# Keep only the package entry points that Mermaid CLI resolves directly.
node_modules/xml2js/lib/xml2js.bc.js
**/node_modules/es-toolkit/**
**/node_modules/dayjs/**
**/node_modules/dompurify/**
**/node_modules/lodash-es/**
**/node_modules/khroma/**
**/node_modules/marked/**
**/node_modules/@upsetjs/**
**/node_modules/@iconify/utils/**
**/node_modules/@iconify/types/**
**/node_modules/browserslist/**
**/node_modules/caniuse-lite/**
**/node_modules/update-browserslist-db/**
**/node_modules/baseline-browser-mapping/**
**/node_modules/electron-to-chromium/**

# Mermaid CLI injects only this stylesheet; its JavaScript helpers and fallback
# font formats are not needed by the Chromium-based renderer.
node_modules/katex/dist/katex.js
node_modules/katex/dist/katex.mjs
node_modules/katex/dist/katex.min.js
node_modules/katex/dist/katex.min.css
node_modules/katex/dist/katex-swap.css
node_modules/katex/dist/katex-swap.min.css
node_modules/katex/dist/contrib/**
node_modules/katex/src/**
node_modules/katex/cli.js
node_modules/katex/node_modules/**
node_modules/katex/dist/README.md
node_modules/katex/dist/fonts/**/*.ttf
node_modules/katex/dist/fonts/**/*.woff
