{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@webview-shared/*": ["./src/shared/*"],
      "@graphics-workbench-typed-protocol": ["../protocol/protocols/typed_protocol.ts"],
      "@graphics-workbench-crop-pdf-protocol": ["../protocol/protocols/crop_pdf_protocol.ts"],
      "@graphics-workbench-merge-pdf-protocol": ["../protocol/protocols/merge_pdf_protocol.ts"],
      "@graphics-workbench-split-pdf-protocol": ["../protocol/protocols/split_pdf_protocol.ts"],
      "@graphics-workbench-rotate-pdf-protocol": ["../protocol/protocols/rotate_pdf_protocol.ts"],
      "@graphics-workbench-reorder-pdf-protocol": ["../protocol/protocols/reorder_pdf_protocol.ts"],
      "@graphics-workbench-preview-protocol": ["../protocol/protocols/preview_protocol.ts"],
      "@graphics-workbench-table-editor-protocol": ["../protocol/protocols/table_editor_protocol.ts"],
      "@graphics-workbench-table-model": ["../protocol/table/table_model.ts"],
      "@graphics-workbench-table-parser": ["../protocol/table/parse_delimited.ts"],
      "@graphics-workbench-table-renderer": ["../protocol/table/table_renderer.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts", "../protocol/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
