    "submenus": [
      {
        "id": "graphics-workbench.cropPdf",
        "label": "%submenu.cropPdf%"
      },
      {
        "id": "graphics-workbench.splitPdf",
        "label": "%submenu.splitPdf%"
      },
      {
        "id": "graphics-workbench.mergePdf",
        "label": "%submenu.mergePdf%"
      },
      {
        "id": "graphics-workbench.rotatePdf",
        "label": "%submenu.rotatePdf%"
      },
      {
        "id": "graphics-workbench.reorderPdf",
