            "type": "string"
          },
          "description": "%config.insertQuarkdown.pdfTemplate%"
        },
        "graphics-workbench.insertQuarkdown.imageTemplate": {
          "type": [
            "string",
            "array"
          ],
          "default": "![${name}](${path} \"${name}\")",
