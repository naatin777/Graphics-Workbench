  "homepage": "https://github.com/naatin777/Graphics-Workbench",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/naatin777/Graphics-Workbench"
  },
  "publisher": "naatin777",
