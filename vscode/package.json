      "explorer/context": [
        {
          "submenu": "graphics-workbench.cropPdf",
          "group": "graphics-workbench",
          "when": "resourceExtname == .pdf && config.graphics-workbench.contextMenu.enabled && config.graphics-workbench.contextMenu.cropPdf.enabled"
        },
        {
          "submenu": "graphics-workbench.splitPdf",
          "group": "graphics-workbench",
          "when": "resourceExtname == .pdf && config.graphics-workbench.contextMenu.enabled && config.graphics-workbench.contextMenu.splitPdf.enabled"
        },
        {
          "submenu": "graphics-workbench.mergePdf",
          "group": "graphics-workbench",
          "when": "resourceExtname == .pdf && config.graphics-workbench.contextMenu.enabled && config.graphics-workbench.contextMenu.mergePdf.enabled"
        },
        {
          "submenu": "graphics-workbench.rotatePdf",
          "group": "graphics-workbench",
          "when": "resourceExtname == .pdf && config.graphics-workbench.contextMenu.enabled && config.graphics-workbench.contextMenu.rotatePdf.enabled"
        },
        {
          "submenu": "graphics-workbench.reorderPdf",
          "group": "graphics-workbench",
          "when": "resourceExtname == .pdf && config.graphics-workbench.contextMenu.enabled && config.graphics-workbench.contextMenu.reorderPdf.enabled"
        },
        {
          "submenu": "graphics-workbench.convert",
          "group": "graphics-workbench",
          "when": "config.graphics-workbench.contextMenu.enabled && (((resourceExtname =~ /^\\.(png|jpe?g|webp|avif|gif|tiff?|svg|mmd|mermaid|drawio|dio)$/i || resourceFilename =~ /\\.(drawio|dio)\\.(png|svg)$/i) && (config.graphics-workbench.conversion.single.enabled || config.graphics-workbench.conversion.combine.enabled)) || ((resourceExtname =~ /^\\.(pdf|gif|webp|drawio|dio)$/i || resourceFilename =~ /\\.(drawio|dio)\\.(png|svg)$/i) && config.graphics-workbench.conversion.split.enabled))"
        },
        {
          "command": "graphics-workbench.rotateImage",
          "group": "graphics-workbench",
          "when": "resourceExtname =~ /^\\.(png|jpe?g|webp|avif|gif|tiff?)$/i && config.graphics-workbench.contextMenu.enabled && config.graphics-workbench.contextMenu.rotateImage.enabled"
        },
        {
          "command": "graphics-workbench.convertDrawioToPagePdfs",
