    "customEditors": [
      {
        "viewType": "graphics-workbench.pdf.preview",
        "displayName": "%customEditor.pdf.preview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "graphics-workbench.tiff.preview",
        "displayName": "%customEditor.tiff.preview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.tiff"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
