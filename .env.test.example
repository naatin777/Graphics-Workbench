# Required by the external-tool integration tests
#   npm run test:external -w core
# the Extension Host integration tests
#   npm run test -w graphics-workbench
# and the packaged Electron Playwright smoke
#   npm run test:playwright:smoke
#
# Copy this file to .env.test.local (gitignored) and fill in the real tool
# paths on this machine. Values already present in the process environment
# take precedence over this file, which is how CI injects the paths.
GRAPHICS_WORKBENCH_TEST_RSVG_CONVERT_PATH=
GRAPHICS_WORKBENCH_TEST_DRAWIO_PATH=
GRAPHICS_WORKBENCH_TEST_CHROME_PATH=
