{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", ".github/scripts/*.mjs", ".vscode-test.mjs", "playwright.config.mjs"],
      "project": [
        "test-support/**/*.ts",
        "scripts/*.{mjs,ts}",
        ".github/scripts/*.mjs",
        ".vscode-test.mjs",
        "playwright.config.mjs"
      ],
      "ignoreDependencies": [
        "@commitlint/types",
        "@types/mocha",
        "@types/node",
        "@types/sinon",
        "@types/vscode",
        "@vscode/test-electron",
        "@vscode/vsce",
        "@vscode/codicons",
        "lefthook",
        "vscode"
      ]
    },
    "core": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "vscode": {
      "entry": [
        "src/extension.ts",
        "src/adapters/crop/crop_pdf_runner.ts",
        "src/commands/pdf/*.ts",
        "src/commands/conversion/*.ts",
        "src/commands/lifecycle/*.ts",
        "src/commands/shared/environment_check.ts",
        "webview/apps/*/src/main.tsx",
        "webview/apps/*/src/app.test.tsx",
        "test/**/*.test.ts",
        "test/e2e/**/*.spec.ts",
        "webview/apps/*/vite.config.ts",
        "webview/apps/*/vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "webview/**/*.{ts,tsx}"],
      "ignoreFiles": ["webview/apps/crop_pdf/src/pdf/pdfjs.ts", "webview/shared/pdf/render_first_page.ts"]
    }
  }
}
