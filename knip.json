{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", ".github/scripts/*.mjs"],
      "project": ["scripts/*.{mjs,ts}", ".github/scripts/*.mjs"],
      "ignoreDependencies": ["@commitlint/types"]
    },
    "core": {
      "entry": ["src/operations/external_tools/crop_worker.ts", "test/**/*.test.ts", "testing/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "testing/**/*.ts", "scripts/**/*.ts"]
    },
    "vscode/protocol": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "vscode/extension": {
      "entry": [
        "src/commands/pdf/*.ts",
        "src/commands/conversion/*.ts",
        "src/commands/lifecycle/*.ts",
        "src/commands/shared/environment_check.ts",
        "test/**/*.test.ts",
        "test/e2e/**/*.spec.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "vscode/webview": {
      "entry": ["src/pages/**/*.test.ts", "src/pages/**/*.test.tsx", "e2e/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "e2e/**/*.ts"]
    }
  }
}
