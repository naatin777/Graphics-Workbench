{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/**/*.test.ts", "test/**/*.spec.ts", "scripts/*.mjs", ".github/scripts/*.mjs", ".vscode-test.mjs"],
      "project": ["test/**/*.ts", "scripts/*.{mjs,ts}", ".github/scripts/*.mjs", ".vscode-test.mjs"],
      "ignoreDependencies": [
        "@commitlint/types",
        "@types/mocha",
        "@types/node",
        "@types/sinon",
        "@types/vscode",
        "@vscode/test-electron",
        "@vscode/vsce",
        "@vscode/codicons",
        "lefthook",
        "vscode"
      ]
    },
    "core": {
      "entry": ["test/*.test.ts", "src/operations/conversion/tools/run_mermaid_cli.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "vscode": {
      "entry": [
        "src/extension.ts",
        "src/operations/pdf/crop_pdf_runner.ts",
        "src/commands/pdf/*.ts",
        "src/commands/conversion/*.ts",
        "src/commands/lifecycle/*.ts",
        "src/commands/shared/environment_check.ts",
        "webview/apps/*/src/main.tsx",
        "webview/apps/*/src/app.test.tsx",
        "webview/apps/*/vite.config.ts",
        "webview/apps/*/vitest.config.ts",
        "webview/excalidraw/entry.ts"
      ],
      "project": ["src/**/*.ts", "webview/**/*.{ts,tsx}"],
      "ignoreFiles": ["webview/apps/crop_pdf/src/pdf/pdfjs.ts", "webview/shared/pdf/render_first_page.ts"]
    }
  }
}
