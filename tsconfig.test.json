{
  // 本番用の設定を継承する。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // test/ も含めるため、ルートをプロジェクト直下に広げる。
    "rootDir": ".",
    "outDir": "out",
    // Node.js 22で利用できる非破壊のArray.prototype.toSortedなどを使う。
    "lib": ["ES2023", "ES2025.Regexp"],
    // テストコードで mocha の describe / it などを使えるようにする。
    "types": ["node", "mocha"]
  },
  // 本番コードとテストコードの両方を型チェック対象にする。
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["out", "node_modules", ".vscode-test", "webview", "media"]
}
