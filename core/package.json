{
  "name": "@graphics-workbench/core",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/public/conversion.js",
  "types": "./dist/public/conversion.d.ts",
  "exports": {
    "./conversion": {
      "types": "./dist/public/conversion.d.ts",
      "import": "./dist/public/conversion.js"
    },
    "./pdf": {
      "types": "./dist/public/pdf.d.ts",
      "import": "./dist/public/pdf.js"
    },
    "./formats": {
      "types": "./dist/public/formats.d.ts",
      "import": "./dist/public/formats.js"
    },
    "./runtime": {
      "types": "./dist/public/runtime.d.ts",
      "import": "./dist/public/runtime.js"
    },
    "./security": {
      "types": "./dist/public/security.d.ts",
      "import": "./dist/public/security.js"
    },
    "./output": {
      "types": "./dist/public/output.d.ts",
      "import": "./dist/public/output.js"
    },
    "./external-tools": {
      "types": "./dist/public/external_tools.d.ts",
      "import": "./dist/public/external_tools.js"
    },
    "./table": {
      "types": "./dist/public/table.d.ts",
      "import": "./dist/public/table.js"
    },
    "./crop-worker": {
      "types": "./dist/public/crop_worker.d.ts",
      "import": "./dist/public/crop_worker.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.testing.json",
    "build:coverage": "tsc -p tsconfig.coverage.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.testing.json",
    "lint": "oxlint --config oxlint.config.ts --type-aware src test testing",
    "lint:fix": "oxlint --config oxlint.config.ts --type-aware --fix src test testing",
    "lint:audit": "oxlint --config oxlint.config.ts --type-aware -D all -D nursery src test testing",
    "generate:test-output": "node scripts/generate-test-output.ts",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:module-mocks": "node --experimental-test-module-mocks --test test/unit/operations/terminate_process_tree.test.ts",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:shuffle": "npm run build && vitest run --sequence.shuffle --sequence.seed=1",
    "test:external": "npm run build && node --env-file-if-exists=../.env.test.local ../node_modules/vitest/vitest.mjs run --config vitest.external.config.ts",
    "test:shuffle:seed": "npm run build && vitest run --sequence.shuffle --sequence.seed=$SEED",
    "test:package-exports": "npm run build && node --test test/package-exports-smoke.test.mjs"
  },
  "dependencies": {
    "better-result": "^3.0.1",
    "fast-xml-parser": "5.10.1",
    "mupdf": "1.28.0",
    "p-queue": "9.3.3",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
