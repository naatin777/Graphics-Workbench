{
  "name": "@graphics-workbench/core",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/public/conversion.js",
  "types": "./dist/public/conversion.d.ts",
  "exports": {
    "./conversion": {
      "types": "./dist/public/conversion.d.ts",
      "import": "./dist/public/conversion.js"
    },
    "./pdf": {
      "types": "./dist/public/pdf.d.ts",
      "import": "./dist/public/pdf.js"
    },
    "./formats": {
      "types": "./dist/public/formats.d.ts",
      "import": "./dist/public/formats.js"
    },
    "./runtime": {
      "types": "./dist/public/runtime.d.ts",
      "import": "./dist/public/runtime.js"
    },
    "./security": {
      "types": "./dist/public/security.d.ts",
      "import": "./dist/public/security.js"
    },
    "./output": {
      "types": "./dist/public/output.d.ts",
      "import": "./dist/public/output.js"
    },
    "./external-tools": {
      "types": "./dist/public/external_tools.d.ts",
      "import": "./dist/public/external_tools.js"
    },
    "./table": {
      "types": "./dist/public/table.d.ts",
      "import": "./dist/public/table.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:coverage": "tsc -p tsconfig.coverage.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src test",
    "lint:fix": "oxlint --type-aware --fix src test",
    "lint:audit": "oxlint --type-aware -D all -D nursery src test",
    "generate:test-output": "node scripts/generate-test-output.ts",
    "compile:test": "tsc -p tsconfig.test.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && npm run compile:test && mocha \"dist-test/core/test/**/*.test.js\" --ignore \"**/terminate_process_tree.test.js\" --ui tdd --timeout 60000",
    "test:module-mocks": "npm run compile:test && node --experimental-test-module-mocks --test dist-test/core/test/unit/operations/terminate_process_tree.test.js",
    "test:coverage": "npm run build && npm run compile:test && c8 --reporter=text-summary --reporter=html --reporter=lcov mocha \"dist-test/core/test/**/*.test.js\" --ignore \"**/terminate_process_tree.test.js\" --ui tdd --timeout 60000",
    "clean:test": "node -e \"const fs = require('node:fs'); fs.rmSync('dist-test', { recursive: true, force: true })\""
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "mupdf": "1.28.0",
    "p-limit": "^7.3.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "c8": "^10.1.3",
    "fast-check": "^4.9.0",
    "mocha": "^11.8.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
